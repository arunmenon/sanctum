{
  "$defs": {
    "Applicability": {
      "additionalProperties": false,
      "properties": {
        "applicability_status": {
          "$ref": "#/$defs/ApplicabilityStatus",
          "default": "unknown"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "effective_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "environment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        }
      },
      "title": "Applicability",
      "type": "object"
    },
    "ApplicabilityStatus": {
      "enum": [
        "known",
        "partial",
        "unknown"
      ],
      "title": "ApplicabilityStatus",
      "type": "string"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "requested": {
          "exclusiveMinimum": 0,
          "title": "Requested",
          "type": "integer"
        },
        "tokenizer_id": {
          "title": "Tokenizer Id",
          "type": "string"
        },
        "used": {
          "minimum": 0,
          "title": "Used",
          "type": "integer"
        }
      },
      "required": [
        "requested",
        "used",
        "tokenizer_id"
      ],
      "title": "Budget",
      "type": "object"
    },
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "title": "A",
          "type": "string"
        },
        "b": {
          "title": "B",
          "type": "string"
        },
        "conflict_id": {
          "title": "Conflict Id",
          "type": "string"
        },
        "relation_type": {
          "$ref": "#/$defs/RelationType"
        },
        "status": {
          "$ref": "#/$defs/ConflictStatus"
        }
      },
      "required": [
        "conflict_id",
        "a",
        "b",
        "relation_type",
        "status"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "ConflictStatus": {
      "enum": [
        "possible_conflict",
        "confirmed_conflict",
        "resolved"
      ],
      "title": "ConflictStatus",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "code",
        "doc",
        "skill",
        "memory",
        "ticket"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRole": {
      "enum": [
        "implemented_behavior",
        "intended_procedure",
        "observed_event",
        "reference",
        "session_history"
      ],
      "title": "EvidenceRole",
      "type": "string"
    },
    "EvidenceStatus": {
      "enum": [
        "sufficient",
        "partial",
        "insufficient",
        "unknown"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "EvidenceUnit": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Applicability",
          "default": {
            "applicability_status": "unknown",
            "branch": null,
            "effective_from": null,
            "effective_to": null,
            "environment": null
          }
        },
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "authority_assertion_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authority Assertion Ref"
        },
        "classification": {
          "default": "internal",
          "title": "Classification",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "duplicates": {
          "description": "Other copies, each keeps provenance",
          "items": {
            "type": "string"
          },
          "title": "Duplicates",
          "type": "array"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "exact_token_count": {
          "minimum": 0,
          "title": "Exact Token Count",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "native_ref": {
          "title": "Native Ref",
          "type": "string"
        },
        "occurred_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "recorded_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The hub's version of the artifact; null when the hub read none",
          "title": "Source Version"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "tokenizer_id": {
          "title": "Tokenizer Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "artifact_id",
        "source_version",
        "native_ref",
        "span",
        "content_hash",
        "text",
        "kind",
        "role",
        "retrieved_at",
        "exact_token_count",
        "tokenizer_id"
      ],
      "title": "EvidenceUnit",
      "type": "object"
    },
    "Interpretation": {
      "additionalProperties": false,
      "properties": {
        "conflict_ids": {
          "items": {
            "type": "string"
          },
          "title": "Conflict Ids",
          "type": "array"
        },
        "entity_ref": {
          "title": "Entity Ref",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "interpretation_id": {
          "title": "Interpretation Id",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "resolution_origin": {
          "title": "Resolution Origin",
          "type": "string"
        }
      },
      "required": [
        "interpretation_id",
        "entity_ref",
        "resolution_origin",
        "evidence_status"
      ],
      "title": "Interpretation",
      "type": "object"
    },
    "Omitted": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "ref_id": {
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "ref_id",
        "reason"
      ],
      "title": "Omitted",
      "type": "object"
    },
    "RelationType": {
      "description": "Typed relation between two evidence units (lab review L04).",
      "enum": [
        "contradiction",
        "policy_implementation_divergence",
        "environment_difference",
        "version_difference"
      ],
      "title": "RelationType",
      "type": "string"
    },
    "ReplayLevel": {
      "enum": [
        "none",
        "recompute_on_candidates",
        "exact_bundle"
      ],
      "title": "ReplayLevel",
      "type": "string"
    },
    "SourceOutcome": {
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SourceStatus"
        }
      },
      "required": [
        "source_id",
        "status"
      ],
      "title": "SourceOutcome",
      "type": "object"
    },
    "SourceStatus": {
      "enum": [
        "called",
        "skipped",
        "timeout",
        "error",
        "unsupported_for_mode"
      ],
      "title": "SourceStatus",
      "type": "string"
    },
    "Span": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/Conflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "degraded_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Degraded Reasons",
      "type": "array"
    },
    "effective_scope_ref": {
      "title": "Effective Scope Ref",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceUnit"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_status": {
      "$ref": "#/$defs/EvidenceStatus"
    },
    "interpretations": {
      "items": {
        "$ref": "#/$defs/Interpretation"
      },
      "title": "Interpretations",
      "type": "array"
    },
    "memory_release_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Release Id"
    },
    "omitted": {
      "items": {
        "$ref": "#/$defs/Omitted"
      },
      "title": "Omitted",
      "type": "array"
    },
    "policy_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "object"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "receipt_id": {
      "title": "Receipt Id",
      "type": "string"
    },
    "replay_expiry": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replay Expiry"
    },
    "replay_level": {
      "$ref": "#/$defs/ReplayLevel"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceOutcome"
      },
      "title": "Sources",
      "type": "array"
    },
    "truncation": {
      "default": false,
      "title": "Truncation",
      "type": "boolean"
    },
    "verdicts": {
      "anyOf": [
        {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "verify mode, only once D7 exists",
      "title": "Verdicts"
    }
  },
  "required": [
    "request_id",
    "receipt_id",
    "effective_scope_ref",
    "replay_level",
    "evidence_status",
    "budget"
  ],
  "title": "EvidenceResponse",
  "type": "object"
}
